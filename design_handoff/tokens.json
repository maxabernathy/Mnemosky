{
  "$schema": "https://schemas.design-tokens.org/tokens.schema.json",
  "meta": {
    "product": "mnemosky",
    "surface": "The Observatory",
    "version": "2.0.0",
    "base": "gallery-8k",
    "baseViewport": { "width": 3840, "height": 2160 },
    "notes": "Values are authored for the 8K gallery build. Use `scales` to derive 4K and desktop sizes."
  },

  "scales": {
    "desktop": {
      "factor": 0.5,
      "viewport": { "width": 1920, "height": 1080 }
    },
    "p4k": {
      "factor": 0.75,
      "viewport": { "width": 2560, "height": 1440 }
    },
    "gallery": {
      "factor": 1.0,
      "viewport": { "width": 3840, "height": 2160 }
    }
  },

  "color": {
    "surface": {
      "night":  "#0F0E0B",
      "night2": "#15130F",
      "panel":  "#1A1713",
      "panel2": "#211E18",
      "line":   "#2B2821"
    },
    "ink": {
      "primary":   "#EDEEDC",
      "secondary": "#AAB097",
      "tertiary":  "#6F7564"
    },
    "accent": {
      "mint":      "#9FE7C2",
      "mercury":   "#C9D3BA",
      "grass":     "#7C9270",
      "grassSoft": "#AEC099"
    },
    "semantic": {
      "satellite": "#D7B877",
      "airplane":  "#D98E5A",
      "anomalous": "#C98FB6"
    }
  },

  "font": {
    "family": {
      "serif":       "\"Times New Roman\", Times, Tinos, \"Liberation Serif\", serif",
      "serifItalic": "\"Times New Roman\", Times, Tinos, \"Liberation Serif\", serif",
      "mono":        "\"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "role": {
      "display.wordmark":   { "family": "serifItalic", "size": 240, "lineHeight": 0.95, "letterSpacing": "0.005em", "case": "lowercase" },
      "display.hero":       { "family": "serifItalic", "size": 140, "lineHeight": 1.00, "letterSpacing": 0,          "case": "sentence" },
      "display.mode":       { "family": "serifItalic", "size": 120, "lineHeight": 1.00, "letterSpacing": 0,          "case": "sentence" },
      "display.modeCard":   { "family": "serifItalic", "size":  72, "lineHeight": 1.00, "letterSpacing": 0,          "case": "title"    },
      "body.italic":        { "family": "serifItalic", "size":  60, "lineHeight": 1.28, "letterSpacing": 0,          "case": "sentence" },
      "body.italicSmall":   { "family": "serifItalic", "size":  46, "lineHeight": 1.05, "letterSpacing": 0,          "case": "sentence" },
      "body.text":          { "family": "serif",       "size":  24, "lineHeight": 1.45, "letterSpacing": 0,          "case": "sentence" },
      "numeric.hero":       { "family": "serifItalic", "size":  96, "lineHeight": 1.00, "letterSpacing": 0,          "case": "tabular", "fontVariantNumeric": "tabular-nums" },
      "numeric.cell":       { "family": "serifItalic", "size":  40, "lineHeight": 1.00, "letterSpacing": 0,          "case": "tabular", "fontVariantNumeric": "tabular-nums" },
      "mono.meta":          { "family": "mono",        "size":  24, "lineHeight": 1.00, "letterSpacing": "0.28em",   "case": "upper"    },
      "mono.label":         { "family": "mono",        "size":  20, "lineHeight": 1.00, "letterSpacing": "0.28em",   "case": "upper"    },
      "mono.micro":         { "family": "mono",        "size":  16, "lineHeight": 1.00, "letterSpacing": "0.20em",   "case": "upper"    }
    }
  },

  "space": {
    "1":  { "gallery":   8, "p4k":   6, "desktop":   4 },
    "2":  { "gallery":  16, "p4k":  12, "desktop":   8 },
    "3":  { "gallery":  24, "p4k":  18, "desktop":  12 },
    "4":  { "gallery":  32, "p4k":  24, "desktop":  16 },
    "5":  { "gallery":  48, "p4k":  36, "desktop":  24 },
    "6":  { "gallery":  64, "p4k":  48, "desktop":  32 },
    "7":  { "gallery":  80, "p4k":  60, "desktop":  40 },
    "8":  { "gallery": 120, "p4k":  90, "desktop":  60 },
    "9":  { "gallery": 180, "p4k": 135, "desktop":  90 },
    "10": { "gallery": 240, "p4k": 180, "desktop": 120 }
  },

  "radius": {
    "sm": 8,
    "md": 10,
    "lg": 16,
    "xl": 18
  },

  "border": {
    "hairline": "1px solid {color.surface.line}",
    "rule":     "2px solid {color.surface.line}",
    "guide":    "2px dashed #1F1D17"
  },

  "motion": {
    "instant":    { "duration": 120,  "easing": "cubic-bezier(0.2, 0, 0, 1)" },
    "settle":     { "duration": 260,  "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "meditative": { "duration": 7000, "easing": "linear" }
  },

  "component": {
    "appShell": {
      "columns":    { "rail": 180, "canvas": "1fr", "sidebar": 640 },
      "rows":       { "topbar": 120, "body": "1fr", "status": 80 },
      "radius":     "{radius.lg}",
      "border":     "{border.rule}"
    },
    "modeRail": {
      "icon": { "size": 88, "radius": "{radius.xl}", "gap": 38, "padding": 40 }
    },
    "canvas": {
      "framePadding":  70,
      "cornerTickSize": 24
    },
    "detectionBbox": {
      "borderWidth": 3,
      "radius":      4,
      "shadow":      "0 0 0 1px rgba(VAR, 0.18), 0 0 42px rgba(VAR, 0.22)"
    },
    "ledger": {
      "height":        140,
      "gap":           18,
      "cellPadding":   "16px 18px",
      "cellRadius":    "{radius.md}",
      "cellBg":        "rgba(15, 14, 11, 0.55)",
      "backdropBlur":  6
    },
    "sidebar": {
      "width":         640,
      "padding":       "36px 36px 28px",
      "blockPadding":  "26px 28px",
      "blockRadius":   "{radius.lg}",
      "blockGap":      28
    },
    "status": {
      "height":        80,
      "padding":       "0 56px",
      "dotSize":       12,
      "dotRing":       "0 0 0 6px rgba(159, 231, 194, 0.18)"
    }
  }
}
